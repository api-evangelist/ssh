  "info": {
    "_postman_id": "dab1f12a-c404-4290-9a88-913790d5eba3",
    "name": "SSH Key Management Authorized Keys API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "A REST API for managing SSH keys, certificates, and access policies in infrastructure environments. Provides endpoints for key generation, certificate signing, authorized keys management, and host key verification. This represents common SSH management capabilities available via OpenSSH tooling and SSH certificate authority implementations.\n\nContact Support:\n Name: OpenSSH Project",
      "type": "text/plain"
    }
  }
